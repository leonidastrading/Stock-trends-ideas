{
  "name": "trend-scout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trend scout: finds real-world changes the market has not priced, writes a thesis card for each, and tracks every card on paper against SPY. Never places an order.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "scan": "tsx scripts/scan.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@neondatabase/serverless": "^1.2.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
