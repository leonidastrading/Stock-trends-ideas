# --- Postgres (Neon / Vercel Postgres connection string) ---
DATABASE_URL=

# --- Dashboard basic auth (every page and API except /api/health and the cron) ---
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Cron auth (Vercel cron sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=

# --- Anthropic (the research model; the model id and effort are set in Settings) ---
ANTHROPIC_API_KEY=

# --- Alpaca market data: daily bars for paper tracking and the Benzinga news stream. Read-only; this app has no order code. ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Set to true if these are paper keys (the trading calendar then comes from paper-api).
ALPACA_PAPER=

# --- Sources (optional; a missing key shows as "missing" on the health panel) ---
# The SEC requires a contact in the User-Agent of automated clients, e.g. "trend-scout you@example.com".
SEC_USER_AGENT=
# efts.sec.gov refuses Vercel's addresses. Deploy relay/ on Railway (see relay/README.md) and point to it here;
# the relay adds the User-Agent itself.
EDGAR_PROXY_URL=
EDGAR_PROXY_TOKEN=
# Google Cloud console → YouTube Data API v3 → API key.
YOUTUBE_API_KEY=
# Reddit: its Responsible Builder Policy requires requesting and getting approval for Data API access first
# (support.reddithelp.com → Developer Platform & Data API Usage). Until the approved app's credentials are
# set here, the Reddit source stays off and shows as "missing". Never uses the unauthenticated endpoints.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- The existing Swing ideas log (the spx-ai-agent app): where a tapped card is sent as a paper idea ---
# https://<spx-ai-agent domain> (no path), and that app's DASHBOARD_USER / DASHBOARD_PASSWORD.
SWING_API_URL=
SWING_API_USER=
SWING_API_PASSWORD=
# That app's Vercel "Protection Bypass for Automation" secret, only if its deployment is protected.
SWING_API_BYPASS=
# Paper size per idea sent, in dollars (default 5000; the swing log caps a position at 10,000).
SWING_NOTIONAL=

# --- Phone alerts (optional, ntfy.sh): subscribe to this topic in the ntfy app ---
NTFY_TOPIC=
# Only for a self-hosted or access-controlled ntfy server
NTFY_SERVER=
NTFY_TOKEN=

# --- Weekly digest email (optional, Resend) ---
RESEND_API_KEY=
ALERT_EMAIL=
# Optional sender, default "Trend scout <onboarding@resend.dev>"
ALERT_FROM=
# Link in the digest email, e.g. https://<this app>.vercel.app
DASHBOARD_URL=

# --- GitHub inbox (optional): your own bot commits PDF / JSON / Markdown files here; the scout reads each once ---
# owner/name of the repo, e.g. vadim/scout-inbox
GITHUB_INBOX_REPO=
# folder in the repo (default inbox) and branch (default: the repo's default branch)
GITHUB_INBOX_PATH=
GITHUB_INBOX_BRANCH=
# fine-grained token with read-only "Contents" on that one repo (not needed for a public repo)
GITHUB_INBOX_TOKEN=

# Schwab market data, read-only (short interest for the Drift tab). Add the callback URL to your Schwab app, then Settings → Connect Schwab.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://trend-scout-livid.vercel.app/api/schwab/callback

# Investigations: web search while following leads (Brave Search API) and federal court dockets (CourtListener, free)
BRAVE_SEARCH_API_KEY=
COURTLISTENER_TOKEN=
# Investigations: Japan (EDINET) and Korea (Open DART) exchange filings, both free
EDINET_API_KEY=
DART_API_KEY=
