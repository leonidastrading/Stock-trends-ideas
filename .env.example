# --- Postgres (Neon / Vercel Postgres connection string) ---
DATABASE_URL=

# --- Dashboard basic auth (every page and API except /api/health and the cron) ---
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Cron auth (Vercel cron sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=

# --- Anthropic (the research model; the model id and effort are set in Settings) ---
ANTHROPIC_API_KEY=

# --- Alpaca market data: daily bars for paper tracking and the Benzinga news stream. Read-only; this app has no order code. ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Set to true if these are paper keys (the trading calendar then comes from paper-api).
ALPACA_PAPER=

# --- Sources (optional; a missing key shows as "missing" on the health panel) ---
# The SEC requires a contact in the User-Agent of automated clients, e.g. "trend-scout you@example.com".
SEC_USER_AGENT=
# Google Cloud console → YouTube Data API v3 → API key.
YOUTUBE_API_KEY=
# Reddit "script" app (optional; without it the public JSON endpoints are used at a lower rate limit).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- The existing Swing ideas log (the spx-ai-agent app): where a tapped card is sent as a paper idea ---
# https://<spx-ai-agent domain> (no path), and that app's DASHBOARD_USER / DASHBOARD_PASSWORD.
SWING_API_URL=
SWING_API_USER=
SWING_API_PASSWORD=
# That app's Vercel "Protection Bypass for Automation" secret, only if its deployment is protected.
SWING_API_BYPASS=
# Paper size per idea sent, in dollars (default 5000; the swing log caps a position at 10,000).
SWING_NOTIONAL=

# --- Weekly digest email (optional, Resend) ---
RESEND_API_KEY=
ALERT_EMAIL=
# Optional sender, default "Trend scout <onboarding@resend.dev>"
ALERT_FROM=
# Link in the digest email, e.g. https://<this app>.vercel.app
DASHBOARD_URL=
